{
  "name": "sketchpad-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @content-forge/sketchpad-web build && pnpm --filter @content-forge/sketchpad build",
    "build:server": "pnpm --filter @content-forge/sketchpad build",
    "build:web": "pnpm --filter @content-forge/sketchpad-web build",
    "dev:web": "pnpm --filter @content-forge/sketchpad-web dev",
    "typecheck": "pnpm -r typecheck",
    "ui": "pnpm --filter @content-forge/sketchpad ui"
  },
  "engines": {
    "node": ">=20"
  }
}
